{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pr-map.dev/schema/pr-map.v2.json",
  "title": "PR Map analysis (AI output)",
  "type": "object",
  "required": ["version", "pr", "readingOrder", "files", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 2 },
    "pr": {
      "type": "object",
      "required": ["repo", "number", "base", "head", "summary"],
      "additionalProperties": false,
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "number": {
          "description": "PR 번호. PR 없이 브랜치만 비교하면 null.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "base": {
          "type": "string",
          "description": "merge-base commit",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "readingOrder": {
      "description": "리뷰어에게 권하는 변경 파일 읽는 순서",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["file", "why"],
        "additionalProperties": false,
        "properties": {
          "file": { "$ref": "#/$defs/id" },
          "why": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "files": {
      "type": "array",
      "items": { "$ref": "#/$defs/file" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 48,
      "description": "Readable slug. Reuse the previous run's id for the same behavior."
    },
    "file": {
      "type": "object",
      "required": ["id", "path", "status", "layer", "role", "tree"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["added", "modified", "deleted", "renamed", "reference"]
        },
        "layer": {
          "description": "역할별 레인. entry: 진입점, core: 핵심 로직, store: 저장소·인프라, ext: 공통·외부",
          "enum": ["entry", "core", "store", "ext"]
        },
        "role": {
          "description": "이 파일이 하는 일 한 줄",
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "oldPath": { "type": "string", "minLength": 1 },
        "replacedBy": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "tree": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "renamed" } } },
          "then": { "required": ["oldPath"] },
          "else": { "not": { "required": ["oldPath"] } }
        },
        {
          "if": { "properties": { "status": { "const": "deleted" } } },
          "then": { "required": ["replacedBy"] },
          "else": { "not": { "required": ["replacedBy"] } }
        }
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "text", "change", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 },
        "change": {
          "enum": ["added", "deleted", "modified", "affected", "unchanged"]
        },
        "affectedBy": {
          "type": "object",
          "required": ["text", "evidence"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 120 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        "unverified": { "const": true },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "tests": {
          "description": "이 분기를 확인하는, 이번 PR에서 바뀐 테스트",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/testEvidence" }
        },
        "children": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "allOf": [
        {
          "if": { "properties": { "change": { "const": "affected" } } },
          "then": { "required": ["affectedBy"] },
          "else": { "not": { "required": ["affectedBy"] } }
        },
        {
          "if": { "required": ["unverified"] },
          "then": { "properties": { "evidence": { "maxItems": 0 } } },
          "else": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    },
    "evidence": {
      "description": "validate가 펼친 뒤의 형식. AI는 SKILL.md의 짧은 문자열로 쓴다.",
      "type": "object",
      "required": ["side", "path", "start", "end", "role"],
      "additionalProperties": false,
      "properties": {
        "side": { "enum": ["base", "head"] },
        "path": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "testEvidence": {
      "description": "head 커밋의 테스트 코드 위치. validate가 펼친 뒤의 형식이며 AI는 짧은 문자열로 쓴다.",
      "type": "object",
      "required": ["path", "start", "end", "role"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "edge": {
      "description": "호출·사용 관계. 삭제 파일의 대체 관계는 files[].replacedBy에만 쓴다.",
      "type": "object",
      "required": ["from", "to", "label"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "unverified": {
          "const": true,
          "description": "코드에서 확인하지 못한 관계(F06)"
        }
      }
    }
  }
}
